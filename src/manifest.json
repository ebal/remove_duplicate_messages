{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.2.0",
  "author": "Thorsten W. Schmidt (original), MailExtension rewrite",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "remove-duplicate-messages@mailextension.local",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "32": "icons/removeduplicates-32.png"
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesDelete",
    "menus",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  }
}
