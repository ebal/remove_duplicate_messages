     xmlns:em="http://www.mozilla.org/2004/em-rdf#">

  <Description about="urn:mozilla:install-manifest">
    <!-- Target Application this extension can install into, 
        with minimum and maximum supported versions. --> 
    <em:targetApplication>
      <Description>
        <em:id>{3550f703-e582-4d05-9a08-453d09bdfdc6}</em:id>
        <em:minVersion>5.0</em:minVersion>
        <em:maxVersion>31.*</em:maxVersion>
      </Description>
    </em:targetApplication>

    <em:type>2</em:type>

    <!-- Front End MetaData -->
    <em:id>{12345678-1234-1234-1234-123456789abc}</em:id>
    <em:name>Remove Duplicate Messages</em:name>
    <em:version>0.1.14</em:version>
    <em:description>Removes duplicate messages by folder context menu.</em:description>
    <em:creator>Thorsten W. Schmidt</em:creator>
    <em:homepageURL>http://addons.mozilla.org</em:homepageURL>

    <!-- Front End Integration Hooks (used by Extension Manager)-->
    <em:optionsURL>chrome://removeduplicates/content/removeduplicatesprefs.xul</em:optionsURL>
    <em:iconURL>chrome://removeduplicates/content/removeduplicates.png</em:iconURL>

