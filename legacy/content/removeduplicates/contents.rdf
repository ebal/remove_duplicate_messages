<?xml version="1.0"?>

<RDF:RDF xmlns:RDF="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:chrome="http://www.mozilla.org/rdf/chrome#">

  <!-- list all the packages being supplied by this jar -->
  <RDF:Seq about="urn:mozilla:package:root">
    <RDF:li resource="urn:mozilla:package:removeduplicates"/>
  </RDF:Seq>

  <!-- package information -->
  <RDF:Description about="urn:mozilla:package:removeduplicates"
        chrome:displayName="Remove Duplicate Messages"
        chrome:author="Thorsten W. Schmidt"
        chrome:name="removeduplicates"
        chrome:description="Removes duplicate messages by folder context menu."
        chrome:extension="true"
        chrome:version="0.1.03"
        chrome:localeVersion="1.1"
        chrome:settingsURL="chrome://removeduplicates/content/removeduplicatesprefs.xul">
  </RDF:Description>

  <!-- overlay information -->
  <RDF:Seq about="urn:mozilla:overlays">
   <RDF:li resource="chrome://messenger/content/mailWindowOverlay.xul"/>
 </RDF:Seq>

 <RDF:Seq about="chrome://messenger/content/mailWindowOverlay.xul">
  <RDF:li>chrome://removeduplicates/content/removeduplicates.xul</RDF:li>
 </RDF:Seq>
</RDF:RDF>
