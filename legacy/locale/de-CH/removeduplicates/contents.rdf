<?xml version="1.0"?>
<RDF:RDF xmlns:RDF="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:chrome="http://www.mozilla.org/rdf/chrome#">

	<!-- list all the locales being supplied -->
	<RDF:Seq about="urn:mozilla:locale:root">
		<RDF:li resource="urn:mozilla:locale:de-CH"/>
	</RDF:Seq>

	<!-- locale information -->
	<RDF:Description about="urn:mozilla:locale:de-CH"
	                 chrome:displayName="Deutsch (de-CH)"
                         chrome:name="de-CH">
		<chrome:packages>
			<RDF:Seq about="urn:mozilla:locale:de-CH:packages">
				<RDF:li resource="urn:mozilla:locale:de-CH:removeduplicates"/>
			</RDF:Seq>
		</chrome:packages>
	</RDF:Description>

	<RDF:Description about="urn:mozilla:locale:de-CH:removeduplicates" chrome:localeVersion="1.1"/>

</RDF:RDF>
