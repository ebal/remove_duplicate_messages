<?xml version="1.0"?>
<RDF:RDF xmlns:RDF="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:chrome="http://www.mozilla.org/rdf/chrome#">

	<!-- list all the locales being supplied -->
	<RDF:Seq about="urn:mozilla:locale:root">
		<RDF:li resource="urn:mozilla:locale:de-LU"/>
	</RDF:Seq>

	<!-- locale information -->
	<RDF:Description about="urn:mozilla:locale:de-LU"
	                 chrome:displayName="Luxemburgish (de-LU)"
                         chrome:name="de-LU">
		<chrome:packages>
			<RDF:Seq about="urn:mozilla:locale:de-LU:packages">
				<RDF:li resource="urn:mozilla:locale:de-LU:removeduplicates"/>
			</RDF:Seq>
		</chrome:packages>
	</RDF:Description>

	<RDF:Description about="urn:mozilla:locale:de-LU:removeduplicates" chrome:localeVersion="1.1"/>

</RDF:RDF>
